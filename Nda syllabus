<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1" />
<title>NDA I 2027 — Dossier</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Archivo+Black&family=Inter:wght@400;500;600&display=swap');

  :root{
    --graphite: #1A1D1F;
    --panel: #24282B;
    --panel-2: #2E3336;
    --steel: #5C6B78;
    --signal: #FF6B35;
    --signal-dim: #FF6B3522;
    --cream: #E8E4DA;
    --field: #6E8F63;
    --line: #3A3F42;
  }

  *{ box-sizing: border-box; }

  body{
    margin:0;
    background: var(--graphite);
    background-image:
      radial-gradient(circle at 20% 10%, #22262900 0%, transparent 50%),
      repeating-radial-gradient(circle at 50% 0%, transparent 0, transparent 60px, #ffffff05 61px, transparent 62px);
    font-family: 'Inter', sans-serif;
    color: var(--cream);
    padding-bottom: 48px;
    -webkit-tap-highlight-color: transparent;
  }

  .mono{ font-family: 'IBM Plex Mono', monospace; }
  .display{ font-family: 'Archivo Black', sans-serif; }

  /* header */
  header{
    padding: 22px 16px 18px;
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }
  header::before{
    content: "";
    position: absolute; inset: 0;
    background-image: repeating-linear-gradient(0deg, #ffffff08 0px, transparent 1px, transparent 22px, #ffffff08 23px);
    pointer-events: none;
  }
  .eyebrow{
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--steel);
    margin-bottom: 6px;
  }
  h1{
    font-size: 21px;
    margin: 0 0 2px;
    letter-spacing: 0.01em;
  }
  .sub{
    color: var(--steel);
    font-size: 12.5px;
    margin-bottom: 18px;
  }

  .stat-row{
    display: flex;
    gap: 10px;
    position: relative;
  }
  .stat{
    flex: 1;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 12px 12px 10px;
    position: relative;
  }
  .stat .lbl{
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel);
    margin-bottom: 6px;
  }
  .stat .val{
    font-size: 24px;
    font-weight: 700;
  }
  .stat.stamp{
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
  }
  .seal{
    width: 46px; height: 46px;
    border-radius: 50%;
    border: 3px solid var(--signal);
    display: flex; align-items:center; justify-content:center;
    transform: rotate(-8deg);
    position: relative;
  }
  .seal.complete{ background: var(--signal-dim); }
  .seal .n{ font-size: 13px; font-weight: 700; color: var(--signal); }

  /* week list */
  .weeks{ padding: 16px 14px 0; }

  .week{
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 3px;
    margin-bottom: 8px;
    overflow: hidden;
  }
  .week.done{ border-color: var(--signal); }

  .week-head{
    width: 100%;
    background: none;
    border: none;
    color: inherit;
    padding: 13px 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    text-align: left;
  }
  .tab{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: var(--steel);
    width: 34px;
    flex-shrink: 0;
  }
  .week.done .tab{ color: var(--signal); }
  .week-head .titles{ flex: 1; min-width: 0; }
  .week-head .wk-title{ font-size: 13.5px; font-weight: 600; }
  .week-head .wk-range{ font-size: 11px; color: var(--steel); margin-top: 1px; }
  .week-head .frac{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    color: var(--field);
    flex-shrink: 0;
  }
  .chev{ color: var(--steel); flex-shrink: 0; font-size: 12px; }

  .week-body{ padding: 0 14px 14px; }
  .bar{
    height: 3px;
    background: var(--panel-2);
    border-radius: 2px;
    margin-bottom: 14px;
    overflow: hidden;
  }
  .bar-fill{ height:100%; background: var(--signal); transition: width .25s ease; }

  .subject{ margin-bottom: 13px; }
  .subject .s-label{
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--field);
    margin-bottom: 3px;
    font-weight: 600;
  }
  .subject .s-topic{
    font-size: 12.5px;
    color: var(--cream);
    line-height: 1.4;
    margin-bottom: 7px;
  }
  .days{ display: flex; gap: 5px; }
  .day{
    flex: 1;
    height: 30px;
    border-radius: 3px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--steel);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10.5px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
  }
  .day.checked{
    background: var(--signal);
    border-color: var(--signal);
    color: var(--graphite);
    font-weight: 700;
  }

  .notes-wrap{ margin-top: 8px; }
  .notes-lbl{
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--steel);
    margin-bottom: 5px;
  }
  textarea{
    width: 100%;
    background: var(--graphite);
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--cream);
    font-family: 'Inter', sans-serif;
    font-size: 12.5px;
    padding: 8px 10px;
    resize: none;
    box-sizing: border-box;
  }
  textarea:focus{ outline: 1px solid var(--signal); border-color: var(--signal); }

  footer{
    text-align: center;
    padding: 18px 0 4px;
    font-size: 10.5px;
    color: var(--steel);
    font-family: 'IBM Plex Mono', monospace;
  }

  @media (prefers-reduced-motion: reduce){
    * { transition: none !important; }
  }
</style>
</head>
<body>

<header>
  <div class="eyebrow mono">SERVICE SELECTION BOARD · NDA I 2027</div>
  <h1>Mission Dossier</h1>
  <div class="sub mono">27-week prep · T-minus <span id="tminus">—</span> days to exam</div>
  <div class="stat-row">
    <div class="stat">
      <div class="lbl">Overall</div>
      <div class="val mono" id="overallPct">0%</div>
    </div>
    <div class="stat">
      <div class="lbl">Sessions</div>
      <div class="val mono" id="overallFrac">0/0</div>
    </div>
    <div class="stat stamp">
      <div class="seal" id="streakSeal"><span class="n mono" id="streakN">0</span></div>
    </div>
  </div>
</header>

<div class="weeks" id="weeks"></div>

<footer id="saveState">local save only · no server, no link-out</footer>

<script>
const SUBJECTS = [
  { key: "maths", label: "Mathematics" },
  { key: "english", label: "English" },
  { key: "gk", label: "General Knowledge" },
];

const WEEKS = [
  { n: 1, range: "Aug 21 – Aug 27", maths: "Sets, relations, complex numbers, binary system", english: "Grammar basics (tenses, parts of speech, articles)", gk: "Physics: matter, density, Archimedes, pressure" },
  { n: 2, range: "Aug 28 – Sep 3", maths: "Progressions (AP/GP/HP)", english: "Grammar: voice, narration", gk: "Physics: Newton's laws, momentum, work-power-energy" },
  { n: 3, range: "Sep 4 – Sep 10", maths: "Quadratic equations, linear inequations", english: "Vocabulary building", gk: "Physics: forces, equilibrium, gravitation, machines" },
  { n: 4, range: "Sep 11 – Sep 17", maths: "Permutation, Combination, Binomial theorem, Logarithms", english: "Synonyms / Antonyms", gk: "Physics: sound, light, mirrors/lenses, human eye" },
  { n: 5, range: "Sep 18 – Sep 24", maths: "Matrices: types, operations", english: "Comprehension passages", gk: "Physics: heat, temperature, conduction/convection/radiation" },
  { n: 6, range: "Sep 25 – Oct 1", maths: "Determinants, adjoint, inverse", english: "Sentence improvement", gk: "Physics: magnetism, electricity, Ohm's law" },
  { n: 7, range: "Oct 2 – Oct 8", maths: "Cramer's rule, Matrix method", english: "Idioms & phrases (set 1)", gk: "Chemistry: changes, elements, valency" },
  { n: 8, range: "Oct 9 – Oct 15", maths: "Trigonometry: ratios, identities", english: "Idioms & phrases (set 2)", gk: "Chemistry: chemical combination laws, air & water" },
  { n: 9, range: "Oct 16 – Oct 22", maths: "Trig: sum/difference, multiple angles", english: "Ordering of words in a sentence", gk: "Chemistry: acids, bases, salts, carbon forms" },
  { n: 10, range: "Oct 23 – Oct 29", maths: "Inverse trig, heights & distances", english: "Selecting words (fill in blanks)", gk: "Chemistry: atomic structure, valency, molecular weight" },
  { n: 11, range: "Oct 30 – Nov 5", maths: "Analytical Geometry 2D: coordinates, lines", english: "Mixed grammar + vocab revision", gk: "History: ancient/medieval India overview" },
  { n: 12, range: "Nov 6 – Nov 12", maths: "2D: circle, parabola/ellipse/hyperbola", english: "Comprehension practice", gk: "History: freedom movement (early phase)" },
  { n: 13, range: "Nov 13 – Nov 19", maths: "3D: distance, direction cosines/ratios", english: "Grammar revision + error spotting", gk: "History: freedom movement (Gandhi era–Independence)" },
  { n: 14, range: "Nov 20 – Nov 26", maths: "3D: equation of plane/line, angles", english: "Vocabulary set 2", gk: "History: Constitution & administration basics" },
  { n: 15, range: "Nov 27 – Dec 3", maths: "Differential Calculus: functions, limits, continuity", english: "Idioms set 3", gk: "History: Five Year Plans, Panchayati Raj, Bhoodan" },
  { n: 16, range: "Dec 4 – Dec 10", maths: "Derivatives: sum/product/quotient rule", english: "Comprehension + sentence improvement", gk: "History: Modern world (Renaissance–Industrial Rev.)" },
  { n: 17, range: "Dec 11 – Dec 17", maths: "Composite function derivatives, 2nd order derivatives", english: "Grammar + vocab combined revision", gk: "History: World Wars, UN, Non-Alignment, ideologies" },
  { n: 18, range: "Dec 18 – Dec 24", maths: "Increasing/decreasing functions, maxima-minima", english: "Idioms set 4", gk: "Geography: Earth, lat/long, time, IDL" },
  { n: 19, range: "Dec 25 – Dec 31", maths: "Integral Calculus: integration methods", english: "Comprehension practice", gk: "Geography: earth movements, rocks, weathering, earthquakes" },
  { n: 20, range: "Jan 1 – Jan 7", maths: "Definite integrals, area under curves", english: "Sentence improvement", gk: "Geography: oceans, atmosphere, winds, rainfall" },
  { n: 21, range: "Jan 8 – Jan 14", maths: "Differential Equations: order, degree, formation", english: "Full mock: English paper", gk: "Geography: world regions, India regional geography" },
  { n: 22, range: "Jan 15 – Jan 21", maths: "Diff. Eq: solving first order/degree", english: "Vocabulary final revision", gk: "General Science: cells, tissues, growth/reproduction" },
  { n: 23, range: "Jan 22 – Jan 28", maths: "Vector Algebra: basics, dot product", english: "Idioms final revision", gk: "Gen. Science: human body, diseases, nutrition, solar system" },
  { n: 24, range: "Jan 29 – Feb 4", maths: "Vector Algebra: cross product, applications", english: "Grammar weak-area fixing", gk: "Current Events: India/world affairs + defence updates" },
  { n: 25, range: "Feb 5 – Feb 11", maths: "Statistics: frequency distribution, central tendency", english: "Mixed practice test", gk: "Current Events: personalities, awards, sports" },
  { n: 26, range: "Feb 12 – Feb 18", maths: "Variance, standard deviation", english: "Mixed practice test", gk: "Weak-topic revision (self-identified)" },
  { n: 27, range: "Feb 19 – Feb 25", maths: "Probability, Bayes' theorem, Binomial distribution", english: "Mixed practice test", gk: "Full GK revision sweep" },
];

const DAY_COUNT = 6;
const STORE_KEY = "nda-dossier-v1";

function loadData(){
  try{
    const raw = localStorage.getItem(STORE_KEY);
    return raw ? JSON.parse(raw) : { checks: {}, notes: {}, open: 1 };
  }catch(e){ return { checks: {}, notes: {}, open: 1 }; }
}
function saveData(data){
  try{
    localStorage.setItem(STORE_KEY, JSON.stringify(data));
    const el = document.getElementById("saveState");
    el.textContent = "saved locally · " + new Date().toLocaleTimeString();
  }catch(e){
    document.getElementById("saveState").textContent = "save failed — storage unavailable";
  }
}

let data = loadData();

function weekProgress(n){
  let done = 0;
  const total = DAY_COUNT * SUBJECTS.length;
  for(let d=1; d<=DAY_COUNT; d++){
    for(const s of SUBJECTS){
      if(data.checks[`w${n}-d${d}-${s.key}`]) done++;
    }
  }
  return { done, total, pct: Math.round((done/total)*100) };
}

function overall(){
  let done = 0;
  const total = WEEKS.length * DAY_COUNT * SUBJECTS.length;
  WEEKS.forEach(w => { done += weekProgress(w.n).done; });
  return { done, total, pct: total ? Math.round((done/total)*100) : 0 };
}

function currentStreak(){
  let streak = 0;
  outer: for(let wi = WEEKS.length - 1; wi >= 0; wi--){
    const w = WEEKS[wi].n;
    for(let d = DAY_COUNT; d >= 1; d--){
      const complete = SUBJECTS.every(s => data.checks[`w${w}-d${d}-${s.key}`]);
      const anyChecked = SUBJECTS.some(s => data.checks[`w${w}-d${d}-${s.key}`]);
      if(complete){ streak++; }
      else if(anyChecked){ break outer; }
    }
  }
  return streak;
}

function daysToExam(){
  const exam = new Date("2027-04-14T00:00:00");
  const now = new Date();
  const diff = Math.ceil((exam - now) / (1000*60*60*24));
  return diff > 0 ? diff : 0;
}

function toggle(weekN, day, subjectKey){
  const id = `w${weekN}-d${day}-${subjectKey}`;
  data.checks[id] = !data.checks[id];
  saveData(data);
  render();
}

function setNote(weekN, text){
  data.notes[weekN] = text;
  saveData(data);
}

function setOpen(n){
  data.open = (data.open === n) ? null : n;
  saveData(data);
  render();
}

function render(){
  const ov = overall();
  const streak = currentStreak();
  document.getElementById("tminus").textContent = daysToExam();
  document.getElementById("overallPct").textContent = ov.pct + "%";
  document.getElementById("overallFrac").textContent = `${ov.done}/${ov.total}`;
  const seal = document.getElementById("streakSeal");
  document.getElementById("streakN").textContent = streak;
  seal.classList.toggle("complete", streak > 0);

  const container = document.getElementById("weeks");
  container.innerHTML = "";

  WEEKS.forEach(w => {
    const prog = weekProgress(w.n);
    const isOpen = data.open === w.n;

    const weekEl = document.createElement("div");
    weekEl.className = "week" + (prog.pct === 100 ? " done" : "");

    const head = document.createElement("button");
    head.className = "week-head";
    head.innerHTML = `
      <span class="tab mono">W${String(w.n).padStart(2,"0")}</span>
      <span class="titles">
        <span class="wk-title">Week ${w.n}</span>
        <span class="wk-range mono">${w.range}</span>
      </span>
      <span class="frac mono">${prog.done}/${prog.total}</span>
      <span class="chev">${isOpen ? "▲" : "▼"}</span>
    `;
    head.onclick = () => setOpen(w.n);
    weekEl.appendChild(head);

    if(isOpen){
      const body = document.createElement("div");
      body.className = "week-body";

      const bar = document.createElement("div");
      bar.className = "bar";
      bar.innerHTML = `<div class="bar-fill" style="width:${prog.pct}%"></div>`;
      body.appendChild(bar);

      SUBJECTS.forEach(s => {
        const subj = document.createElement("div");
        subj.className = "subject";
        const daysHtml = Array.from({length: DAY_COUNT}).map((_, i) => {
          const day = i + 1;
          const id = `w${w.n}-d${day}-${s.key}`;
          const checked = !!data.checks[id];
          return `<button class="day${checked ? " checked" : ""}" data-week="${w.n}" data-day="${day}" data-subj="${s.key}">${checked ? "✓" : day}</button>`;
        }).join("");
        subj.innerHTML = `
          <div class="s-label">${s.label}</div>
          <div class="s-topic">${w[s.key]}</div>
          <div class="days">${daysHtml}</div>
        `;
        body.appendChild(subj);
      });

      const notesWrap = document.createElement("div");
      notesWrap.className = "notes-wrap";
      notesWrap.innerHTML = `
        <div class="notes-lbl mono">Weak points — carry forward</div>
        <textarea rows="2" placeholder="Is week ka weak area likh...">${data.notes[w.n] || ""}</textarea>
      `;
      body.appendChild(notesWrap);

      weekEl.appendChild(body);
    }

    container.appendChild(weekEl);
  });

  container.querySelectorAll(".day").forEach(btn => {
    btn.onclick = () => toggle(Number(btn.dataset.week), Number(btn.dataset.day), btn.dataset.subj);
  });
  container.querySelectorAll("textarea").forEach((ta, idx) => {
    ta.oninput = (e) => {
      const openWeek = data.open;
      setNote(openWeek, e.target.value);
    };
  });
}

render();
</script>
</body>
</html>

